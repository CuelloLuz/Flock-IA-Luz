{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist/jira-dashboard/browser",
  "framework": null,
  "rewrites": [
    { "source": "/api/jira/:path*", "destination": "/api/jira?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
