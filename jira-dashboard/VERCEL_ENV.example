# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno para Vercel — Dashboard de Seguimiento Flock AI Day 2026
# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo, completá los valores y pegalo en:
#   Vercel → Project → Settings → Environment Variables
#
# NO commitear este archivo con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Login del dashboard ───────────────────────────────────────────────────────
# Usuario y contraseña que verá el usuario final al ingresar al tablero.
APP_USER=demo
APP_PASS=flock2026

# ── Integración Jira (opcional) ───────────────────────────────────────────────
# Si no se configuran, el dashboard corre en modo mock con datos de prueba.
JIRA_BASE_URL=https://TU-ORG.atlassian.net
JIRA_EMAIL=tu-email@empresa.com
JIRA_API_TOKEN=tu-api-token-de-jira
JIRA_PROJECT=SCRUM

# ── BFF OAuth 2.0 (si se deploya el backend jira-bff por separado) ────────────
# Generadas en https://developer.atlassian.com/console/myapps/
CLIENT_ID=tu-client-id-de-atlassian
CLIENT_SECRET=tu-client-secret-de-atlassian

# URL de callback que debe coincidir con la configurada en Atlassian Developer Console
REDIRECT_URI=https://tu-bff.vercel.app/auth/callback

# URL del frontend Angular (para que el BFF redirija después del login)
FRONTEND_URL=https://tu-dashboard.vercel.app

# Clave secreta para firmar las sesiones del BFF (usar un string aleatorio largo)
SESSION_SECRET=cambiar-por-string-aleatorio-seguro-en-produccion

PORT=3001
